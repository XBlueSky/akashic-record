      "signature": "namespace App\\Services",
      "content": "namespace App\\Services {\n    /**\n     * A simple calculator class demonstrating method extraction.\n     */\n    class Calculator\n    {\n        private int $state;\n\n        public function __construct(int $initial)\n        {\n            $this->state = $initial;\n        }\n\n        public function add(int $a, int $b): int\n        {\n            $result = $a + $b;\n            return $result;\n        }\n\n        private function helper(): int\n        {\n            return $this->add(1, 2);\n        }\n\n        public static function version(): string\n        {\n            return self::release();\n        }\n\n        protected static function release(): string\n        {\n            return \"1.0\";\n        }\n    }\n}",
