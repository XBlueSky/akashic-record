      "content": "class Counter {\n    var count: Int\n    private var step: Int\n\n    init(start: Int) {\n        self.count = start\n        self.step = 1\n    }\n\n    public func increment() {\n        self.bump()\n    }\n\n    private func bump() {\n        count += step\n    }\n}",
