      "signature": "pub fn outer(items: &[i32]) -> i32",
      "content": "pub fn outer(items: &[i32]) -> i32 {\n    let factor = 2;\n\n    fn scale(x: i32, factor: i32) -> i32 {\n        x * factor\n    }\n\n    fn total(items: &[i32], factor: i32) -> i32 {\n        items.iter().map(|&i| scale(i, factor)).sum()\n    }\n\n    total(items, factor)\n}",
