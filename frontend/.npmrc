# Pin the public registry regardless of the developer machine's global npm
# config — several local machines in this org point npm at an internal
# mirror (https://npm.synology.inc), and `npm ci` fetches straight from
# each package-lock.json "resolved" URL, so a lockfile regenerated against
# that mirror is unreachable from GitHub Actions / any host off the
# corporate network. See docs/operations/ci-gates.md.
registry=https://registry.npmjs.org

# vite declares an optional peerDependency on a newer esbuild
# (^0.27.0 || ^0.28.0) than svelte-i18n's pinned esbuild@0.19.12 needs;
# nothing in this project overrides vite's bundled esbuild. Without this,
# npm auto-installs the newer esbuild (+ all 26 platform binaries) to
# satisfy the peer dep and mis-serializes them as "extraneous" instead of
# "optional" in package-lock.json, which makes a plain `npm ci` hard-fail
# with EBADPLATFORM on any platform that isn't the one the lockfile was
# generated on. Must match on every `npm install`/`npm ci` invocation
# (local and CI) or the lockfile and package.json read as "out of sync".
legacy-peer-deps=true
