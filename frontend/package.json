{
  "name": "akashic-record-viewer",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm audit --omit=dev --json > .audit-output.json ; node scripts/audit-gate.mjs < .audit-output.json",
    "e2e": "docker run --rm --network host -v \"${PWD}\":/work -w /work mcr.microsoft.com/playwright:v1.60.0-jammy npm run e2e:inner",
    "e2e:inner": "playwright test",
    "e2e:headed": "docker run --rm --network host -e DISPLAY -v /tmp/.X11-unix:/tmp/.X11-unix -v \"${PWD}\":/work -w /work mcr.microsoft.com/playwright:v1.60.0-jammy npm run e2e:headed:inner",
    "e2e:headed:inner": "playwright test --headed",
    "e2e:debug": "PWDEBUG=1 docker run --rm --network host -e PWDEBUG -v \"${PWD}\":/work -w /work mcr.microsoft.com/playwright:v1.60.0-jammy npm run e2e:inner",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.17.0",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/svelte": "^5.3.1",
    "@types/d3": "^7.4.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/three": "^0.184.1",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "js-yaml": "^4.1.1",
    "jsdom": "^25.0.1",
    "shadcn-svelte": "^1.3.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.5.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@threlte/core": "^8.5.16",
    "@types/dompurify": "^3.0.5",
    "d3": "^7.9.0",
    "dompurify": "^3.4.12",
    "github-slugger": "^2.0.0",
    "markdown-it": "^14.3.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "marked": "^18.0.5",
    "mermaid": "^11.16.0",
    "shiki": "^4.3.1",
    "svelte-i18n": "^4.0.1",
    "three": "^0.184.0"
  }
}
